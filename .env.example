# Copia este archivo como .env y rellena los valores de tu proyecto Firebase.
# Los encontrarás en Consola de Firebase → Configuración del proyecto → Tus apps → App web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave pública VAPID de Cloud Messaging (Configuración → Cloud Messaging → Certificados push web).
VITE_FIREBASE_VAPID_KEY=

# Opcional (recomendado al publicar): clave de sitio de reCAPTCHA Enterprise para App Check.
# Ver SETUP.md, apartado «Proteger la base de datos con App Check».
VITE_APPCHECK_SITE_KEY=

# Para la política de privacidad (/privacidad): quién es el responsable de los datos y un
# correo de contacto. Si se dejan vacíos, se usa el repositorio de GitHub.
VITE_RESPONSABLE_NOMBRE=
VITE_CONTACTO_EMAIL=

# Opcional: pon "true" para conectar con los emuladores locales de Firebase en desarrollo.
VITE_USAR_EMULADORES=false
# Opcional: puertos de los emuladores si los de por defecto (9099 y 8080) están ocupados.
VITE_EMULADOR_PUERTO_AUTH=
VITE_EMULADOR_PUERTO_FIRESTORE=
